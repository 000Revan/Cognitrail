APP_NAME=Cognitrail
APP_TIMEZONE=Asia/Shanghai
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cognitrail_community
DB_USER=root
DB_PASSWORD=
DB_REQUIRED_VERSION=8.0.14
DB_CONNECT_TIMEOUT=3
# 可选：只有RUN_DB_TESTS=1且显式指定独立测试库时才执行社区数据库用例。
# TEST_DB_NAME=cognitrail_community_test
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
LOG_LEVEL=INFO
# 执行 uv run python -m scripts.configure_auth 在本地生成签名密钥，不要提交真实密钥。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=cognitrail
JWT_AUDIENCE=cognitrail-web
ACCESS_TOKEN_SECONDS=7200
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# 头像可选，缺省使用项目默认头像。目录默认 backend/.data/avatars，需持久化备份。
# AVATAR_STORAGE_DIR=G:/aicoding/classproject/Cognitrail/backend/.data/avatars
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_PIXELS=16000000
AVATAR_SIZE=512
# R07站内通知后台任务，不需要Redis或消息队列；不修改实际.env也使用这些默认值。
OUTBOX_ENABLED=true
OUTBOX_POLL_SECONDS=2
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=8
DISCUSSION_USER_RATE_LIMIT=20
DISCUSSION_IP_RATE_LIMIT=60
DISCUSSION_RATE_WINDOW_SECONDS=60
