APP_NAME=Cognitrail
APP_TIMEZONE=Asia/Shanghai
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cognitrail_community
DB_USER=root
DB_PASSWORD=
# 精确匹配 SELECT VERSION() 去掉连字符发行后缀后的版本，不是最低版本。
# Docker 部署时先查询容器版本，再配置此值；更换版本仍需验证迁移兼容性。
DB_REQUIRED_VERSION=8.0.14
DB_CONNECT_TIMEOUT=3
# 可选：只有RUN_DB_TESTS=1且显式指定独立测试库时才执行社区数据库用例。
# TEST_DB_NAME=cognitrail_community_test
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
LOG_LEVEL=INFO
# 执行 uv run python -m scripts.configure_auth 在本地生成签名密钥，不要提交真实密钥。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=cognitrail
JWT_AUDIENCE=cognitrail-web
ACCESS_TOKEN_SECONDS=7200
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# 头像可选，缺省使用项目默认头像。目录默认 backend/.data/avatars，需持久化备份。
# 省略时使用默认目录；Compose 覆盖为 /app/.data/avatars 并挂载数据卷。
# AVATAR_STORAGE_DIR=
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_PIXELS=16000000
AVATAR_SIZE=512
# 站内通知后台任务，不需要 Redis 或消息队列。
OUTBOX_ENABLED=true
OUTBOX_POLL_SECONDS=2
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=8
DISCUSSION_USER_RATE_LIMIT=20
DISCUSSION_IP_RATE_LIMIT=60
DISCUSSION_RATE_WINDOW_SECONDS=60

# 工坊助手模型配置；不使用助手时可留空，调用助手时需要 API Key 和模型名。
LLM_API_KEY=
LLM_MODEL=
# 可选的 OpenAI 兼容接口地址；留空时使用 SDK 默认地址。
LLM_BASE_URL=
# 单次网络操作超时（1～300 秒）及整轮生成总超时（1～600 秒）。
LLM_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=180

# Graph 状态文件；省略时使用 backend/.data/agent/checkpoints.sqlite。
# Compose 覆盖为 /app/.data/agent/checkpoints.sqlite，需与 MySQL 会话数据配套备份。
# AGENT_CHECKPOINT_PATH=
