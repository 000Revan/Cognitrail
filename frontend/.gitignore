# 前端独立使用时也生效；保留 src/、public/ 和 index.html。
# 保留 Dockerfile、.dockerignore、Vite / TypeScript / ESLint 配置、
# package.json、pnpm-lock.yaml、pnpm-workspace.yaml 与环境配置模板。

# 本地环境配置与凭证；前端配置模板保留。
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
*.local
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# 下载的依赖、包管理器缓存与构建产物。
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.bun/
.vite/
.cache/
.cache-loader/
.eslintcache
.stylelintcache
.ruff_cache/
*.tsbuildinfo
/dist/
/build/

# 测试源码、独立测试配置及测试产物仅留本地。
tests/
test/
__tests__/
__mocks__/
